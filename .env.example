# Copy this file to .env and fill in the values.
# Keep sensitive values secret and do NOT commit your real credentials to version control.

# Flask secret key
SECRET_KEY=change-me-to-a-secure-random-value

# Database
# By default the app stores SQLite DB at data/detections.db
DATABASE_PATH=

# Email settings for automated inbox scanning (IMAP)
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993

# Scheduler
SCAN_INTERVAL_MINUTES=5

# Alerting (SMTP) - used by AlertSystem
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_FROM=noreply@example.com
